# Copy to .env for local use, or set these in your host's environment settings.
# Everything is optional locally: without them the app uses a SQLite file and
# an uploads/ folder.

# Signs login cookies. Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Password for /admin. Admin is switched off until this is set.
ADMIN_PASSWORD=

# Supabase Postgres connection string (Project Settings → Database → Session pooler)
DATABASE_URL=

# Supabase Storage for photos/videos (Project Settings → API). The service
# role key is secret — server only, never in front-end code or git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cookies are https-only when DATABASE_URL is set. Set to 1 if you host with
# SQLite over https, or 0 if you use Supabase from plain http on your computer.
COOKIE_SECURE=
